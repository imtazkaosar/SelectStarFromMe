from employees;

select employee_id,last_name,salary, salary*12
from employees;

select employee_id,last_name,salary, salary*15/100
from employees;


select employee_id empid, last_name emp_name, salary,round(salary*15/100)tax, salary-(round(salary*15/100))gsal
from   employees;


select employee_id empid, last_name emp_name, salary,((salary + 500) * 12), ((salary * 12) + 500) 
from   employees ; 

select employee_id, last_name, salary, commission_pct 
from   employees ;


update employees 
set    salary = null  
where  employee_id = 175 ; 

select employee_id, last_name, salary, commission_pct 
from   employees ;

select employee_id, last_name, salary, commission_pct, 
salary * commission_pct ann_sal 
from   employees ; 

select employee_id, last_name, salary, commission_pct, 
salary + commission_pct ann_sal 
from   employees ;

select employee_id as "Emp ID", last_name "Emp Name",  
salary "Salary", commission_pct "Comm", 
salary + commission_pct as "Annual Salary" 
from   employees ; 


select employee_id, first_name, last_name 
from   employees ; 

select employee_id, first_name||last_name 
from   employees ; 

select employee_id, first_name||' '||last_name emp_name 
from   employees ; 


select employee_id, first_name||' and his last name '||last_name emp_name 
from   employees ;
 

select first_name||q'{ and his last's name }'||last_name emp_name 
from   employees ;

select department_id, department_name  
from   departments ; 


select distinct department_id 
from   employees ; 


select distinct department_id 
from   employees  
where  department_id is not null ; 


select distinct department_id, last_name 
from   employees  
where  department_id is not null ; 

