select employee_id, last_name, salary, hire_date, department_id 
from   employees  
where  hire_date between '01-jan-03' and '31-dec-03' ; 


select employee_id, employee_name, department_name, city,  
to_char(hire_date, 'DD-Mon-YYYY')hire_date, salary,  
salary * 12 annual_salary, round((sysdate - hire_date) / 365)job_years 
from   EMPLOYEE_VIEW 
where  hire_date between '01-jan-03' and '31-dec-03' ; 




Like: 


L  
e  
..r  
f. 
a.t 
%u% 
% 
_ 
d% 
%t 


select employee_id, last_name, salary, hire_date, department_id 
from   employees  
where  last_name like 'L%' ; 


select employee_id, last_name, salary, hire_date, department_id 
from   employees  
where  last_name like '%r' ; 

select employee_id, last_name, salary, hire_date, department_id 
from   employees  
where  last_name like '__i%' ; 

select employee_id, last_name, salary, hire_date, department_id 
from   employees  
where  last_name like '%o_' ; 

select employee_id, last_name, salary, hire_date, department_id 
from   employees  
where  last_name like 'M%s' ; 


select employee_id, last_name, salary, hire_date, department_id 
from   employees  
where  lower(last_name) like lower('m%S') ; 

select employee_id, last_name, department_id, manager_id, commission_pct 
from   employees  
order  by 1 ; 

select employee_id, last_name, department_id, manager_id, commission_pct 
from   employees  
where  department_id is null 
order  by 1 ; 

select employee_id, last_name, department_id, manager_id, commission_pct 
from   employees  
where  manager_id is null 
order  by 1 ; 

select employee_id, last_name, department_id, manager_id, commission_pct 
from   employees  
where  commission_pct is null 
order  by 1 ; 


select employee_id, last_name, department_id, manager_id, commission_pct 
from   employees  
where  commission_pct is not null 
order  by 1 ; 


SELECT employee_id, last_name, job_id, salary 
FROM   employees 
WHERE  salary >= 10000 
AND    job_id LIKE '%MAN%' ; 

SELECT employee_id, last_name, job_id, salary 
FROM   employees 
WHERE  salary >= 10000 
OR     job_id LIKE '%MAN%' ; 

SELECT employee_id, last_name, salary, ((salary * 12) + 200)sal1, 
(salary + 200 * 12)sal2 
FROM   employees;



SELECT last_name, job_id, salary 
FROM   employees 
WHERE  job_id = 'SA_REP' 
OR     job_id = 'AD_PRES' 
AND    salary > 15000; 


 
SQL Row Limiting Clause: 


SELECT employee_id, last_name, salary 
FROM   employees 
order  by salary desc ; 

SELECT employee_id, last_name, salary 
FROM   employees 
order  by salary desc  
FETCH FIRST 3 ROWS ONLY ; 

SELECT employee_id, last_name, salary 
FROM   employees 
order  by salary desc  
OFFSET 3 ROWS FETCH NEXT 2 ROWS ONLY ; 



Substitution Variables: 

SELECT employee_id, last_name, salary, department_id 
FROM   employees 
where  employee_id = &emp_id 
order  by employee_id ; 


SELECT employee_id, last_name, salary, department_id 
FROM   employees 
where  department_id = &dept_id 
order  by employee_id ; 

SELECT employee_id, last_name, salary, department_id 
FROM   employees 
where  department_id = &&dept_id 
order  by employee_id ; 

format:

select &col1, &col2, &col3 
from   &table_name 
where  &condition 
order  by &order_by ;

SELECT last_name, department_id, salary*12 
FROM   employees 
WHERE  job_id = &job_title ; 


SELECT last_name, department_id, salary*12 
FROM   employees 
WHERE  job_id = '&job_title' ; 



SELECT employee_id, last_name, job_id, &&column_name 
FROM   employees 
ORDER  BY &column_name ; 


SELECT employee_id, last_name, job_id 
FROM   employees 
where  employee_id = &eid ; 

SELECT employee_id, last_name, job_id 
FROM   employees 
where  employee_id = &eid ; 

SELECT employee_id, last_name, job_id 
FROM   employees 
where  employee_id = &emp_id ; 
