106 rows selected.

SQL> select employee_id, last_name,
  2         e.department_id, department_name,
  3      d.location_id, e.manager_id,
  4      city, postal_code, l.country_id, country_name,
  5      c.region_id, region_name, e.job_id, job_title
  6  from   employees e, departments d, locations l,
  7         countries c, regions r, jobs j
  8  where  e.department_id = d.department_id
  9  and    d.location_id = l.location_id
 10  and    l.country_id = c.country_id
 11  and    c.region_id = r.region_id
 12  and    e.job_id = j.job_id
 13  order  by 1;

