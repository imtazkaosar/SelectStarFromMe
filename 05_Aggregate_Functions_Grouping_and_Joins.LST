SQL> select employee_id, last_name, e.department_id, department_name,
  2      d.location_id, e.manager_id, city, postal_code, l.country_id,
  3      country_name, c.region_id, region_name, e.job_id, job_title
  4  from   employees e, departments d, locations l,
  5         countries c, regions r, jobs j
  6  where  e.department_id = d.department_id
  7  and    d.location_id = l.location_id
  8  and    l.country_id = c.country_id
  9  and    c.region_id = r.region_id
