106 rows selected.

SQL> select employee_id, last_name,
  2         e.department_id, department_name,
  3      d.location_id, e.manager_id,
  4      city, postal_code, l.country_id, country_name,
  5      c.region_id, region_name
  6  from   employees e, departments d, locations l, countries c, regions r
  7  where  e.department_id = d.department_id
  8  and    d.location_id = l.location_id
  9  and    l.country_id = c.country_id
 10  and    c.region_id = r.region_id
 11  order  by 1;

