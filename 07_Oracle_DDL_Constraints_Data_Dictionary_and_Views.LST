SQL> select e.employee_id, e.first_name||' '||e.last_name as employee_name, e.salary,
  2  e.salary * 12 as annual_salary, e.commission_pct as commission, e.hire_date,
  3  round((sysdate - hire_date) / 365)years, e.department_id, d.department_name,
  4  d.location_id, l.STREET_ADDRESS, l.POSTAL_CODE, l.city, l.country_id, c.country_name,
  5  c.region_id, r.region_name, e.job_id, j.job_title, j.min_salary, j.max_salary
  6  from  employees e, departments d, locations l,
  7  countries c, regions r, jobs j
  8  where e.department_id = d.department_id(+)
  9  and   d.location_id = l.location_id(+)
 10  and   l.country_id = c.country_id(+)
 11  and   c.region_id = r.region_id(+)
 12  and   e.job_id = j.job_id(+)
 13  order by employee_id;

