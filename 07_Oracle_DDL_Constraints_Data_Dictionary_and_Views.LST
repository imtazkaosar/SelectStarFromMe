Sequence: 

create table a1 
( 
id    number primary key, 
name  varchar2(10) 
) ;

create sequence a1_id_pk_seq;

create sequence a2_id_pk_seq 
start with 50 
increment by 5; 

select a1_id_pk_seq.nextval from dual; 
select a1_id_pk_seq.currval from dual; 

select a2_id_pk_seq.nextval from dual;
select a2_id_pk_seq.currval from dual; 

insert into a1(id, name) 
values(a1_id_pk_seq.nextval, 'A-1'); 

drop sequence a1_id_pk_seq; 

drop sequence a2_id_pk_seq; 

create sequence a1_id_pk_seq;

create table a2 
( 
id    number default a1_id_pk_seq.nextval primary key, 
name  varchar2(10) 
); 


insert into a2( name) 
values('A-1'); 

