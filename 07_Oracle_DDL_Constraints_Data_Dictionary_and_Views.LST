SQL> create or replace view emp_view
  2  as
  3  select e.employee_id, e.first_name||' '||e.last_name as employee_name, e.salary,
  4  e.salary * 12 as annual_salary, e.commission_pct as commission, e.hire_date,
  5  round((sysdate - hire_date) / 365)years, e.department_id, d.department_name,
  6  d.location_id, l.STREET_ADDRESS, l.POSTAL_CODE, l.city, l.country_id, c.country_name,
  7  c.region_id, r.region_name, e.job_id, j.job_title, j.min_salary, j.max_salary
  8  from  employees e, departments d, locations l,
  9  countries c, regions r, jobs j
 10  where e.department_id = d.department_id(+)
 11  and   d.location_id = l.location_id(+)
 12  and   l.country_id = c.country_id(+)
 13  and   c.region_id = r.region_id(+)
 14  and   e.job_id = j.job_id(+)
 15  order by employee_id;

