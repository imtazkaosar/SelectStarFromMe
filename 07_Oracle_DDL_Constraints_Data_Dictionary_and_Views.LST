SQL> create view ev
  2  as
  3  select eid, name, salary, salary * 12 ann_sal, nid, jdate join_date,
  4         emp.dept_id, dept_name, round((sysdate - jdate)/365)years
  5  from   emp, dept
  6  where  emp.dept_id = dept.dept_id;

