select employee_id, last_name, salary 
from   employees  
where  lower(last_name) = lower('kIng') ; 


select employee_id, last_name, salary 
from   employees  
where  upper(last_name) = Upper('kIng') ; 

show user

select user from dual;

select sysdate from dual;

select current_date from dual;

desc dual;

select CONCAT('Hello', 'World') 
from   dual ; 

select SUBSTR('HelloWorld',1,5) 
from   dual ; 

select INSTR('HelloWorld', 'W') 
from   dual ; 

select salary, lpad(salary, 8, '*') 
from   employees ; 

select salary, rpad(salary, 8, '#') 
from   employees ; 

select salary, rpad(salary, 8, '0') 
from   employees ; 

select REPLACE('JACK and JUE','J','BL') 
from   dual ; 

select TRIM('H' FROM 'HelloWorld') 
from   dual; 

select TRIM(' ' FROM '  HelloWorld') 
from   dual; 

SELECT employee_id, CONCAT(first_name, last_name) NAME, 
job_id, LENGTH (last_name)LENGTH_last_name, 
last_name, INSTR(last_name, 'a') "Contains 'a'?" 
FROM   employees 
WHERE  SUBSTR(job_id, 4) = 'REP'; 


select LENGTH('Likhan') 
from   dual ; 

SELECT last_name, UPPER(CONCAT(SUBSTR(LAST_NAME, 1, 3), '-ABC')) 
FROM   employees 
WHERE  department_id = 60;

SELECT ROUND(45.923,2),  
ROUND(45.967,2), 
ROUND(45.967,0), 
ROUND(45.967), 
ROUND(45.923,-1), 
ROUND(44.989,-1) 
FROM   DUAL; 

SELECT trunc(45.923,2),  
trunc(45.967,2), 
trunc(45.967,0), 
trunc(45.967), 
trunc(45.923,-1), 
trunc(44.989,-1) 
FROM   DUAL; 


select mod(100, 30) 
from   dual ; 

SELECT last_name, salary, MOD(salary, 5000) 
FROM   employees ; 



DD-MON-YYYY 
25-SEP-2026 

select sysdate, sysdate + 2 
from   dual ; 

select sysdate, sysdate + 2, sysdate - 2 
from   dual ; 

select employee_id, last_name, hire_date, 
sysdate - hire_date days 
from   employees ; 


select employee_id, last_name, hire_date, 
round(sysdate - hire_date) days 
from   employees ; 

select employee_id, last_name, hire_date, 
round((sysdate - hire_date) / 365) years 
from   employees ; 


select employee_id, last_name, hire_date, 
round((sysdate - hire_date) / 365) years 
from   employees  
order  by 4 ; 


select employee_id, last_name, hire_date, 
round((sysdate - hire_date) / 7) weeks 
from   employees  
order  by 4 ;


select employee_id, last_name, hire_date, 
round((sysdate - hire_date) / 30) months 
from   employees  
order  by 4 ; 

select employee_id, last_name, hire_date, 
round((to_date('31-Dec-15', 'DD-Mon-RR') - hire_date) / 30) months 
from   employees  
order  by 4 ; 

select MONTHS_BETWEEN('01-SEP-95','11-JAN-94') 
from   dual ; 

select NEXT_DAY ('25-Sep-26','FRIDAY') 
from   dual ; 

select to_char(sysdate,'DD-MM-YYYY') 
from   dual ; 


select to_char(sysdate,'DD-MONTH-YYYY') 
from   dual ; 

select to_char(sysdate,'DD-MM-RRRR') 
from   dual ; 

select hire_date, to_char(hire_date,'YYYY') years 
from   employees ; 

select distinct to_char(hire_date,'YYYY') years 
from   employees  
order  by 1 ; 

select count(employee_id) total_emp 
from   employees  
group  by hire_date 
order  by 1 ; 

select distinct to_char(hire_date,'YYYY') years, count(employee_id) total_emp 
from   employees  
group  by to_char(hire_date,'YYYY') 
order  by 1 ; 


select to_char(sysdate,'DD-MM-RRRR hh:mi:ss') 
from   dual ; 

select to_char(sysdate,'DD-MM-RRRR hh:mi:ss am') 
from   dual ; 

select to_char(sysdate,'DD-MM-RRRR hh24:mi:ss') 
from   dual ; 

select to_char(sysdate,'Ddspth "of" Month') 
from   dual ; 

select hire_date, to_char(hire_date,'DD-Mon-YYYY') years 
from   employees ; 

select hire_date, to_char(hire_date,'DD-Mon-YYYY') years, 
to_char(hire_date,'fmDD-Month-YYYY') years 
from   employees ; 

select 192234569, to_char(192234569, '99,99,99,999.00') 
from   dual ; 

select 192234569, to_char(192234569, '00,00,00,000.00') 
from   dual ; 

select 192234569, to_char(34569, '99,99,99,999.00') 
from   dual ; 

select 192234569, to_char(34569, '00,00,00,000.00') 
from   dual ; 

select 192234569, to_char(34569, '$99,99,99,999.00') 
from   dual ; 

select 192234569, to_char(34569, 'L99,99,99,999.00') 
from   dual ; 

SELECT last_name, TO_CHAR(hire_date, 'DD-Mon-YYYY') 
FROM   employees 
WHERE  hire_date < TO_DATE('01-Jan-90','DD-Mon-RR'); 

SELECT last_name, TO_CHAR(hire_date, 'DD-Mon-YYYY') 
FROM   employees 
WHERE  hire_date < TO_DATE('01-Jan-90','DD-Mon-YY'); 

select employee_id, last_name, salary, commission_pct 
from   employees 
order  by employee_id ; 

select employee_id, last_name, salary, commission_pct, 
salary * commission_pct sal_com 
from   employees 
order  by employee_id ; 

select employee_id, last_name, salary, commission_pct, 
nvl(salary,0) * nvl(commission_pct,0) sal_com 
from   employees 
order  by employee_id ; 

SELECT last_name, salary, NVL(commission_pct, 0), 
(salary*12) + (salary*12*NVL(commission_pct, 0)) AN_SAL 
FROM   employees; 

SELECT last_name, salary, commission_pct, 
NVL2(commission_pct, 'SAL+COMM', 'SAL') income 
FROM   employees  
WHERE  department_id IN (50, 80); 

SELECT last_name, salary, commission_pct, 
NVL2(commission_pct, salary * commission_pct, salary) income 
FROM   employees  
WHERE  department_id IN (50, 80); 

SELECT first_name, LENGTH(first_name) "expr1", 
last_name, LENGTH(last_name) "expr2", 
NULLIF(LENGTH(first_name), LENGTH(last_name)) result 
FROM   employees ; 

SELECT last_name, employee_id, 
COALESCE(TO_CHAR(commission_pct),TO_CHAR(manager_id),'No commission and no manager') 
FROM   employees ; 

SELECT last_name, employee_id, commission_pct, manager_id,  
COALESCE(TO_CHAR(commission_pct),TO_CHAR(manager_id),'No commission and no 
manager')cm1 
FROM   employees ; 

SELECT last_name, job_id, salary, 
CASE job_id WHEN 'IT_PROG'  THEN 1.10*salary 
WHEN 'ST_CLERK' THEN 1.15*salary 
WHEN 'SA_REP'   THEN 1.20*salary 
ELSE salary  
END "REVISED_SALARY" 
FROM employees; 

SELECT last_name, job_id, salary, 
DECODE(job_id, 'IT_PROG', 1.10*salary, 
'ST_CLERK', 1.15*salary, 
'SA_REP', 1.20*salary, 
salary)REVISED_SALARY 
FROM   employees; 

